# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 作業用の画像置き場（本番で使う画像は public/characters にコピーして管理する）
/サンプル画像

# 作業用のBGM置き場（使う曲だけ public/audio にコピーして管理する。docs/spec/audio.md参照）
/音楽

# typescript
*.tsbuildinfo
next-env.d.ts
